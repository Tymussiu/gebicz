
import java.util.Random;
import java.util.Scanner;

public class Main {
    static final int N = 50;
    public static void wypelnijTablice(int[] tab) {
        Random random = new Random();
        for (int i = 0; i < N; i++) {
            tab[i] = random.nextInt(100) + 1;
        }
    }
    public static int wyszukaj(int[] tab, int szukana) {
        tab[N] = szukana; 
        int i = 0;
        while (tab[i] != szukana) {
            i++;
        }
        if (i == N) {
            return -1;
        }
        return i; 
    }
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        int[] tab = new int[N + 1];
        wypelnijTablice(tab);
        System.out.println("Zawartosc tablicy:");
        for (int i = 0; i < N; i++) {
            System.out.print(tab[i]);
            if (i < N -1) {
                System.out.print(", ");
            }
        }
        System.out.println();
        System.out.print("Podaj liczbe do wyszukania: ");
        int szukana = scanner.nextInt();
        int wynik = wyszukaj(tab, szukana);
        if (wynik == -1) {
            System.out.println("Nie znaleziono liczby " + szukana + " w tablicy.");
        } else {
            System.out.println("Znaleziono liczbe " + szukana + " pod indeksem: " + wynik);
        }
        scanner.close();
    }
}
